#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_scalar_block_layout : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Acceleration structure
layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;

// G-Buffer textures
layout(binding = 1, set = 0) uniform sampler2D depthTexture;
layout(binding = 2, set = 0) uniform sampler2D normalTexture;

// Output illumination (RGB: Direct Shadow * LightColor, A: Ambient Occlusion)
layout(binding = 3, set = 0, rgba16f) writeonly uniform image2D outIllumination;

layout(push_constant) uniform PushConstants {
    mat4 invViewProj;
    vec4 cameraPos;     // xyz = cameraPos, w = unused
    vec4 lightDir;      // xyz = lightDir (normalized), w = shadowIntensity
    vec4 lightColor;    // xyz = lightColor, w = aoRadius
    int frameIndex;
    int aoSamples;
    int renderWidth;
    int renderHeight;
} pc;

// Simple hash for pseudo-random hemisphere directions
float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

vec3 getCosineHemisphereSample(vec3 normal, vec2 uv) {
    float r1 = hash12(uv + vec2(float(pc.frameIndex) * 0.13, 0.37));
    float r2 = hash12(uv + vec2(0.71, float(pc.frameIndex) * 0.19));

    float phi = 2.0 * 3.14159265359 * r1;
    float cosTheta = sqrt(1.0 - r2);
    float sinTheta = sqrt(r2);

    vec3 localDir = vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);

    // Build tangent frame from normal
    vec3 up = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitangent = cross(normal, tangent);

    return normalize(tangent * localDir.x + bitangent * localDir.y + normal * localDir.z);
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    if (pixelCoord.x >= pc.renderWidth || pixelCoord.y >= pc.renderHeight) {
        return;
    }

    vec2 uv = (vec2(pixelCoord) + 0.5) / vec2(pc.renderWidth, pc.renderHeight);
    float depth = texture(depthTexture, uv).r;

    // Sky / Far plane early-out
    if (depth >= 1.0) {
        imageStore(outIllumination, pixelCoord, vec4(1.0, 1.0, 1.0, 1.0));
        return;
    }

    // Reconstruct world position from depth
    vec4 clipPos = vec4(uv.x * 2.0 - 1.0, (1.0 - uv.y) * 2.0 - 1.0, depth, 1.0);
    vec4 worldPosH = pc.invViewProj * clipPos;
    vec3 worldPos = worldPosH.xyz / worldPosH.w;

    // Sample world normal
    vec3 normal = texture(normalTexture, uv).xyz;
    if (length(normal) < 0.1) {
        normal = vec3(0.0, 1.0, 0.0);
    } else {
        normal = normalize(normal);
    }

    // Normal-offset origin to avoid self-intersection
    vec3 rayOrigin = worldPos + normal * 0.008;

    // ==========================================
    // ==========================================
    // 1. Direct Sun/Moon Ray Query Shadow with Colored Stained Glass Transmission
    // ==========================================
    vec3 sunDir = normalize(pc.lightDir.xyz);
    vec3 shadowTransmission = vec3(0.0);

    // Only cast shadow ray if surface faces the light
    float NdotL = max(0.0, dot(normal, sunDir));
    if (NdotL > 0.001) {
        int shadowRays = pc.aoSamples > 1 ? min(pc.aoSamples, 4) : 1;

        // Build tangent frame for sun disk cone sampling
        vec3 sunUp = abs(sunDir.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
        vec3 sunTangent = normalize(cross(sunUp, sunDir));
        vec3 sunBitangent = cross(sunDir, sunTangent);
        const float SUN_ANGULAR_RADIUS = 0.015; // Realistic solar disk angle for contact penumbra

        for (int s = 0; s < shadowRays; s++) {
            vec3 jitteredSunDir = sunDir;
            if (shadowRays > 1) {
                float r1 = hash12(uv + vec2(float(s) * 0.31 + float(pc.frameIndex) * 0.17, 0.43));
                float r2 = hash12(uv + vec2(0.59, float(s) * 0.47 + float(pc.frameIndex) * 0.29));
                float phi = 2.0 * 3.14159265359 * r1;
                float r = sqrt(r2) * SUN_ANGULAR_RADIUS;
                jitteredSunDir = normalize(sunDir + (sunTangent * cos(phi) + sunBitangent * sin(phi)) * r);
            }

            rayQueryEXT rqShadow;
            rayQueryInitializeEXT(
                rqShadow,
                topLevelAS,
                gl_RayFlagsNoneEXT,
                0xFF,
                rayOrigin,
                0.001,
                jitteredSunDir,
                160.0 // Max shadow ray distance
            );

            vec3 rayFilter = vec3(1.0);
            while(rayQueryProceedEXT(rqShadow)) {
                if (rayQueryGetIntersectionTypeEXT(rqShadow, false) == gl_RayQueryCandidateIntersectionTriangleEXT) {
                    // Candidate hit: Check for stained glass voxel transmission
                    float hitT = rayQueryGetIntersectionTEXT(rqShadow, false);
                    vec3 hitPos = rayOrigin + jitteredSunDir * hitT;
                    vec3 blockCoord = floor(hitPos);
                    float h = hash12(blockCoord.xz + blockCoord.y * 0.41);
                    vec3 glassTint = clamp(abs(mod(h * 6.0 + vec3(0.0, 4.0, 2.0), 6.0) - 3.0) - 1.0, 0.0, 1.0);
                    rayFilter *= mix(vec3(1.0), glassTint * 1.6, 0.75);
                    rayQueryConfirmIntersectionEXT(rqShadow);
                }
            }

            if (rayQueryGetIntersectionTypeEXT(rqShadow, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
                shadowTransmission += rayFilter;
            }
        }
        shadowTransmission /= float(shadowRays);
    }

    // ==========================================
    // 2. Ambient Occlusion (AO) Ray Query
    // ==========================================
    float aoRadius = max(0.5, pc.lightColor.w);
    int sampleCount = max(1, pc.aoSamples);
    float unoccludedCount = 0.0;

    for (int i = 0; i < sampleCount; i++) {
        vec3 aoDir = getCosineHemisphereSample(normal, uv);

        rayQueryEXT rqAO;
        rayQueryInitializeEXT(
            rqAO,
            topLevelAS,
            gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT,
            0xFF,
            rayOrigin,
            0.001,
            aoDir,
            aoRadius
        );

        while(rayQueryProceedEXT(rqAO)) {}

        if (rayQueryGetIntersectionTypeEXT(rqAO, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
            unoccludedCount += 1.0;
        }
    }

    float aoFactor = unoccludedCount / float(sampleCount);

    vec3 directLight = pc.lightColor.xyz * shadowTransmission * NdotL;
    imageStore(outIllumination, pixelCoord, vec4(directLight, aoFactor));
}
