#version 460
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, set = 0) uniform sampler2D lowResColorTexture;
layout(binding = 1, set = 0) uniform sampler2D depthTexture;
layout(binding = 2, set = 0) uniform sampler2D velocityTexture;
layout(binding = 3, set = 0) uniform sampler2D historyTexture;

layout(binding = 4, set = 0, rgba16f) writeonly uniform image2D outReconstructed;

layout(push_constant) uniform PushConstants {
    vec2 jitterOffset;  // in low-res pixel units [-0.5, 0.5]
    int renderWidth;
    int renderHeight;
    int displayWidth;
    int displayHeight;
    int resetHistory;
} pc;

vec3 RGBtoYCoCg(vec3 c) {
    return vec3(
         c.r * 0.25 + c.g * 0.5 + c.b * 0.25,
         c.r * 0.5  - c.b * 0.5,
        -c.r * 0.25 + c.g * 0.5 - c.b * 0.25
    );
}

vec3 YCoCgtoRGB(vec3 c) {
    return vec3(
        c.x + c.y - c.z,
        c.x + c.z,
        c.x - c.y - c.z
    );
}

void main() {
    ivec2 nativeCoord = ivec2(gl_GlobalInvocationID.xy);
    if (nativeCoord.x >= pc.displayWidth || nativeCoord.y >= pc.displayHeight) {
        return;
    }

    vec2 nativeUv = (vec2(nativeCoord) + 0.5) / vec2(pc.displayWidth, pc.displayHeight);

    // Unjittered sample coordinate in low-resolution space
    vec2 lowResUv = nativeUv - (pc.jitterOffset / vec2(pc.renderWidth, pc.renderHeight));
    vec2 velocity = texture(velocityTexture, lowResUv).xy;
    vec2 prevNativeUv = nativeUv - velocity;

    // 1. Sample 3x3 neighborhood in low-resolution space to compute color bounding box
    vec2 texelSize = 1.0 / vec2(pc.renderWidth, pc.renderHeight);
    vec3 minColor = vec3(1e10);
    vec3 maxColor = vec3(-1e10);
    vec3 centerSample = texture(lowResColorTexture, lowResUv).rgb;

    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec3 sampleColor = texture(lowResColorTexture, lowResUv + vec2(x, y) * texelSize).rgb;
            vec3 ycocg = RGBtoYCoCg(sampleColor);
            minColor = min(minColor, ycocg);
            maxColor = max(maxColor, ycocg);
        }
    }

    // 2. Sample and clip history
    bool validHistory = (pc.resetHistory == 0) &&
                        (prevNativeUv.x >= 0.0 && prevNativeUv.x <= 1.0 &&
                         prevNativeUv.y >= 0.0 && prevNativeUv.y <= 1.0);

    vec3 finalColor;

    if (validHistory) {
        vec3 prevColor = texture(historyTexture, prevNativeUv).rgb;
        vec3 prevYCoCg = RGBtoYCoCg(prevColor);

        // Clamp history to current neighborhood bounding box to prevent ghosting
        vec3 clampedYCoCg = clamp(prevYCoCg, minColor, maxColor);
        vec3 clampedHistory = YCoCgtoRGB(clampedYCoCg);

        // Higher blend weight for steady camera, lower for fast motion
        float velocityMag = length(velocity * vec2(pc.displayWidth, pc.displayHeight));
        float alpha = clamp(0.1 + velocityMag * 0.05, 0.08, 0.9);

        finalColor = mix(clampedHistory, centerSample, alpha);
    } else {
        finalColor = centerSample;
    }

    imageStore(outReconstructed, nativeCoord, vec4(finalColor, 1.0));
}
